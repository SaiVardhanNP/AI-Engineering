GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# frontend origins allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# only needed if AGENT_LLM=groq, and the config requires the name to exist
GROQ_API_KEY=
# which model runs the agents: gemini or groq
AGENT_LLM=gemini
